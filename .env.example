NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Passcode the host uses to log into /admin. Pick something only you know.
ADMIN_PASSCODE=
# Random long secret used to sign the admin session cookie. Generate with:
#   openssl rand -hex 32
ADMIN_COOKIE_SECRET=

# The public URL guests will open (used to render the QR code).
# For local dev this can stay as http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
